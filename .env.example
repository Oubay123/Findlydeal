# ---------------------------------------------------------------------------
# Findlydeal — environment variables
# Copy this file to `.env.local` and fill in the values. Never commit `.env*`.
# Values below are placeholders only: no real key must ever land in this file.
# ---------------------------------------------------------------------------

# --- App ---------------------------------------------------------------------
# Public base URL, used for metadata, canonical URLs and sitemaps.
#
# LEAVE EMPTY IN PRODUCTION: the code already defaults to https://findlydeal.com.
# Only set this for a preview deployment on another domain, or locally when you
# need absolute URLs to point at your machine. Any value other than localhost
# must use https, otherwise the build fails on purpose: an http canonical tells
# search engines to index the insecure version of every page.
NEXT_PUBLIC_SITE_URL=""

# --- Affiliate sources -------------------------------------------------------
# One block per source. A source stays disabled as long as its credentials are
# missing, so the app runs fine with none of them configured.
# See src/lib/sources/ for the matching adapter.

# eBay Partner Network + eBay Browse API — see docs/deploiement.md
# In production these live in Cloudflare (Workers > findlydeal > Settings >
# Variables and Secrets), never in this file. Locally, in .env.local.
# Production keyset from https://developer.ebay.com/my/keys (App ID / Cert ID):
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
# eBay Partner Network campaign id (https://partnernetwork.ebay.com/):
# without it, links are plain eBay links and earn nothing.
EBAY_CAMPAIGN_ID=""
# Optional: tag that comes back in EPN reports (defaults to "findlydeal").
EBAY_REFERENCE_ID=""
EBAY_MARKETPLACE_ID="EBAY_FR"
# "production" (default) or "sandbox".
EBAY_ENVIRONMENT=""

# Supabase: catalogue storage (optional; Workers KV is used without it).
# See docs/deploiement.md and supabase/migrations/. Server-side only: the
# service role key must never be exposed to the browser.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Wayfair (affiliate network feed) — adapter not created yet
WAYFAIR_API_KEY=""
WAYFAIR_AFFILIATE_ID=""

# --- Optional services -------------------------------------------------------
# Translation / multilingual query expansion (see src/lib/search/translate.ts).
TRANSLATION_API_KEY=""

# Currency conversion rates provider (see src/lib/utils/currency.ts).
CURRENCY_API_KEY=""
